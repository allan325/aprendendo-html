:root {
    --cor-primaria:#cc3434;
    --cor-primaria-escura: #660c0c;
    --cor-destaque: #e02c53;
    --cor-fundo:#070707;
    --cor-branca:#ffffff;
    --cor-borda:#24501900;
    --cor-de-texto: #dd1313;
    --sombra-padrao:#3f1a1a9d;
    --raio-borda: 14px;
    --largura-maxima:1100px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0%;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(cor --cor-de-texto);
    background-color: var(--cor-fundo);
    line-height: 1.6 ;
    min-height: 100vh;
}

header {
    background: linear-gradient(
        180drg,
        var(--cor-primaria)
        var(--cor-primaria-escura)
    );
    color:var(--cor-branca);
    padding: 50px 20px;
    text-align: center;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);

}

header h1 {
    color: var(--cor-de-texto);
    font-size:2.6rem ;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

header p {
    color: var(--cor-de-texto);
    font-size:1.1rem ;
    opacity: 0.9;
    margin-bottom: 25px;
}

nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
}

nav a {
    text-decoration: none;
    color: var(--cor-branca) ;
    padding: 10px 18px;
    border: 1px solid rgba(255, 255, 255, 0,35);
    border-radius: 999px;
    font-weight: 600;
    transition: 0.3 ease ;
}

nav a:hover {
    background-color: var(--cor-branca);
    color:var(--cor-primaria);
    transform: translateY(-2px);
}

main {
    max-width: var(--largura-maxima);
    margin: 40px auto;
    padding: 0 20px;
}

section {
    background-color: var(--cor-branca);
    padding: 30px;
    margin: 25x;
    border-radius: var(--raio-borda);
    box-shadow: var(--sombra-padrao);
    border:1px solid rgba(0, 0, 0, 0.04);
}

section h2 {
    color:var(--cor-primaria) ;
    font-size:1.7rem ;
    margin-bottom:18px ;
    border-bottom:2px solid #c2c1c1;;
    padding-bottom:10px ;
}

#sobre p {
    max-width: 800px;
    color: var(--cor-de-texto);
}


#filme img {
    width: 350px;
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 15px;
    border: 3px solid #c43131;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.12);
} 


#anime img {
    width: 350px;
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 15px;
    border: 3px solid #c43131;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.12);
} 


#serie img {
    width: 350px;
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 15px;
    border: 3px solid #c43131;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.12);
} 

#serie table {
    width: 100%;
    border-collapse:collapse ;
    margin-top: 10px;
    border: none;
}
#serie th,
#serie td {
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid var(--cor-borda);
}

#serie th {
    font-weight: 700;
}

#serie tbody tr:nth-child(even){
    background: #d18484;
}

#serie tbody tr:hover {
    background: rgb(196, 57, 57) ;
    transition: background-color 0.2s ease ;
}

form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

#formulario form p {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

label{
    font-weight: 600;
    color: var(--cor-texto);
}

input,select,textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--sombra-padrao);
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    background-color: var(--cor-branca);
    color: var(--cor-de-texto);
    transition: order-color 0.2 ease,box-shadow ease;
}

textarea{
    resize: vertical;
    min-height: 110px;
}

input:focus,select:focus,textarea:focus {
    outline: none;
    border-color:var(--cor-destaque) ;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.16);
}

button{
    background-color: var(--cor-primaria);
    color: var(--cor-branca);
    border: none;
    padding: 12px 22px;
    border-radius: 8px;font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    align-self: flex-start;
    transition: 03s ease;
}

button:hover {
    background-color: var(--cor-primaria-escura);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(15, 43, 95, 0.22);
}

button:active{
    transform: translateY(0);
}
